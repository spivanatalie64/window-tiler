+ I ThisWindow (!Maximized, !FullScreen, !FixedSize, !Iconic) Maximize false
+ I ThisWindow (!Maximized, !FullScreen, !FixedSize, !Iconic) ResizeMove frame 50wa 50wa 0 0

DestroyFunc FuncTileTopRight
