# Window Tiler - Tile & Snap Functions for FVVM3
# ===============================================

# Snap to screen edges (used by autosnap and title buttons)
# These functions tile the active window to various positions

DestroyFunc FuncTileUp
AddToFunc FuncTileUp
+ I ThisWindow (!Maximized, !FullScreen, !FixedSize, !Iconic) Maximize false
+ I ThisWindow (!Maximized, !FullScreen, !FixedSize, !Iconic) ResizeMove frame 100wa 50wa 0 0

DestroyFunc FuncTileDown
AddToFunc FuncTileDown
+ I ThisWindow (!Maximized, !FullScreen, !FixedSize, !Iconic) Maximize false
+ I ThisWindow (!Maximized, !FullScreen, !FixedSize, !Iconic) ResizeMove frame 100wa 50wa 0 -0

DestroyFunc FuncTileLeft
AddToFunc FuncTileLeft
+ I ThisWindow (!Maximized, !FullScreen, !FixedSize, !Iconic) Maximize false
+ I ThisWindow (!Maximized, !FullScreen, !FixedSize, !Iconic) ResizeMove frame 50wa 100wa 0 0

DestroyFunc FuncTileRight
AddToFunc FuncTileRight
+ I ThisWindow (!Maximized, !FullScreen, !FixedSize, !Iconic) Maximize false
+ I ThisWindow (!Maximized, !FullScreen, !FixedSize, !Iconic) ResizeMove frame 50wa 100wa -0 0

DestroyFunc FuncTileTopLeft
